{
  "title": "FinAnalytics API Overview",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "API Requests",
      "targets": [
        {
          "expr": "finanalytics_api_requests_total"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "API Latency",
      "targets": [
        {
          "expr": "finanalytics_api_latency_seconds_count"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      }
    }
  ]
}
